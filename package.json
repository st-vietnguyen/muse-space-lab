{
  "name": "musespace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "lefthook": "^2.2.2",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "lint": "prettier --check . && eslint . && depcruise --config .dependency-cruiser.mjs --output-type err .",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "format": "prettier --write .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install"
  }
}
